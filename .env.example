# Copy to .env and generate DJANGO_SECRET_KEY locally. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
DATABASE_URL=postgresql://smart_sales:CHANGE_ME@127.0.0.1:55432/smart_sales
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8002,http://localhost:8002
DEMO_MODE=false
# Optional demo users are created only via `manage.py seed_demo --password-env DEMO_PASSWORD`.
DEMO_PASSWORD=
# Docker Compose only; use URL-safe letters and digits in this password.
POSTGRES_PASSWORD=
